global:
  scrape_interval: 15s
  evaluation_interval: 15s

rule_files:
  - /etc/prometheus/rules.yml

scrape_configs:
  - job_name: agentops-backend
    metrics_path: /actuator/prometheus
    static_configs:
      - targets: ["backend:8080"]

# BEGIN copilotguard
  - job_name: copilotguard
    static_configs:
      - targets: ["__COPILOTGUARD_HOST__:__COPILOTGUARD_PORT__"]
# END copilotguard

# BEGIN agentdiff
  - job_name: agentdiff
    static_configs:
      - targets: ["__AGENTDIFF_HOST__:__AGENTDIFF_PORT__"]
# END agentdiff
